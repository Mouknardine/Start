# Variables d'environnement d'Artisano.
# En local : copier ce fichier en .env.local et le remplir (jamais committé).
# Sur Vercel : Project Settings → Environment Variables.

# --- Supabase (obligatoire) -------------------------------------------------
# Project Settings → API dans le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : côté serveur uniquement (rate limiting, scripts admin).
# Ne jamais la préfixer NEXT_PUBLIC_ ni l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL publique du site (facultatif) --------------------------------------
# Sans valeur, Vercel fournit VERCEL_PROJECT_PRODUCTION_URL (ex. artisano-one.vercel.app),
# sinon https://artisano.ch. Ne la renseigner qu'une fois le domaine branché sur Vercel :
# elle sert aux liens des emails, aux URL canoniques et aux images de partage.
NEXT_PUBLIC_SITE_URL=

# --- Emails transactionnels (Resend) ----------------------------------------
# Sans clé, aucun email n'est envoyé (les demandes restent enregistrées).
RESEND_API_KEY=
# Expéditeur vérifié dans Resend. Par défaut : Artisano <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# --- Monitoring Sentry (facultatif) ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Upload des source maps au build
SENTRY_ORG=
SENTRY_PROJECT=

# --- Statistiques Plausible (facultatif) ------------------------------------
# Domaine déclaré dans Plausible ; chargé seulement après consentement cookies.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
